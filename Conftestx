    crosshairCenterFrame = Instance.new("Frame", btnFrame)
    crosshairCenterFrame.Size = UDim2.new(0, 2, 0, 2)
    crosshairCenterFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    crosshairCenterFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    crosshairCenterFrame.BackgroundTransparency = 1

    local lines = {"Top", "Bottom", "Left", "Right"}
    local sizes = {Top = UDim2.new(0,3,0,16), Bottom = UDim2.new(0,3,0,16), Left = UDim2.new(0,16,0,3), Right = UDim2.new(0,16,0,3)}
    local positions = {Top = UDim2.new(0.5,-1,0,-22), Bottom = UDim2.new(0.5,-1,0,6), Left = UDim2.new(0,-22,0.5,-1), Right = UDim2.new(0,6,0.5,-1)}
    for _, dir in ipairs(lines) do
        local l = Instance.new("Frame", crosshairCenterFrame)
        l.Size = sizes[dir]
        l.Position = positions[dir]
        l.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        l.BorderSizePixel = 0
    end

    local clickBtn = Instance.new("TextButton", btnFrame)
    clickBtn.Size = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text = ""
    
    -- Ateş etme basma tespiti
    clickBtn.MouseButton1Click:Connect(function() 
        task.spawn(doShoot) 
    end)

    -- Sürükleme için Gelişmiş Bağımsız input Yakalayıcı
    local isDragging = false
    local dragOffset = Vector2.new()

    clickBtn.InputBegan:Connect(function(input)
        if LOCK_SHOOT_BTN then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            local touchPosition = input.Position
            dragOffset = Vector2.new(touchPosition.X - btnFrame.AbsolutePosition.X, touchPosition.Y - btnFrame.AbsolutePosition.Y)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local currentTouchPosition = input.Position
            -- Ekran sınırları içinde pürüzsüz taşıma hesabı
            btnFrame.Position = UDim2.new(0, currentTouchPosition.X - dragOffset.X, 0, currentTouchPosition.Y - dragOffset.Y)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
end

