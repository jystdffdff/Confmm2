    end
end)

-- Gecikmesiz Anlık ESP Motoru
local function applyESP(player)
    if player == lp or not ESP_ON then return end
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    
    if hrp then
        local role = getPlayerRole(player)
        local color = (role == "Katil" and COLOR_KATIL) or (role == "Şerif" and COLOR_SERIF) or COLOR_MASUM
        local tagText = (role == "Katil" and "[KATİL]") or (role == "Şerif" and "[ŞERİF]") or "[MASUM]"

        local hl = char:FindFirstChild(HL_TAG) or Instance.new("Highlight", char)
        hl.Name = HL_TAG
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 1
        hl.OutlineColor = color

        local head = char:WaitForChild("Head", 5)
        if head then
            local bb = head:FindFirstChild(BB_TAG) or Instance.new("BillboardGui", head)
            bb.Name = BB_TAG
            bb.AlwaysOnTop = true
            bb.Size = UDim2.new(0, 160, 0, 32)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            local lbl = bb:FindFirstChild("TextLabel") or Instance.new("TextLabel", bb)
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = player.DisplayName .. "\n" .. tagText
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 11
            lbl.TextColor3 = color
        end
    end
end

Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(function() task.wait(0.1) if ESP_ON then applyESP(p) end end) end)
for _, p in ipairs(Players:GetPlayers()) do p.CharacterAdded:Connect(function() task.wait(0.1) if ESP_ON then applyESP(p) end end) end

local function removeESP(character)
    local hl = character:FindFirstChild(HL_TAG) if hl then hl:Destroy() end
    local head = character:FindFirstChild("Head") if head then local bb = head:FindFirstChild(BB_TAG) if bb then bb:Destroy() end end
end

