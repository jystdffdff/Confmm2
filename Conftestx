-- Rol Bulucu
local function getPlayerRole(player)
    if not player or not player.Character then return "Masum" end
    local char = player.Character
    if char:FindFirstChild("Knife") or char:FindFirstChild("Bıçak") then return "Katil" end
    if char:FindFirstChild("Gun") or char:FindFirstChild("Silah") then return "Şerif" end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        if backpack:FindFirstChild("Knife") or backpack:FindFirstChild("Bıçak") then return "Katil" end
        if backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Silah") then return "Şerif" end
    end
    return "Masum"
end

-- Gecikmesiz Yerden Silah Toplama Sistemi
local function setupDroppedGun(obj)
    if not obj or not GET_GUN_ON then return end
    task.wait(0.02)
    
    local gunPart = nil
    if obj.Name == "GunDrop" or obj.Name == "Normal" or obj.Name == "WeaponDrop" then
        gunPart = obj:IsA("Part") and obj or (obj:FindFirstChild("Handle") or obj:FindFirstChild("GunDrop") or obj.PrimaryPart)
    elseif obj:IsA("Model") and obj.Name:lower():find("gun") then
        gunPart = obj:FindFirstChild("Handle") or obj:FindFirstChild("GunDrop") or obj.PrimaryPart
    end

    if gunPart and not gunPart:FindFirstChild(GROUND_GUN_TAG) then
        local adorn = Instance.new("BoxHandleAdornment")
        adorn.Name = GROUND_GUN_TAG
        adorn.Size = gunPart.Size + Vector3.new(0.6, 0.6, 0.6)
        adorn.AlwaysOnTop = true
        adorn.ZIndex = 10
        adorn.Color3 = Color3.fromRGB(0, 0, 0)
        adorn.Transparency = 0.2
        adorn.Adornee = gunPart
        adorn.Parent = gunPart

        local bb = Instance.new("BillboardGui", gunPart)
        bb.Name = GROUND_GUN_TAG .. "BB"
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 100, 0, 30)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        
        local lbl = Instance.new("TextLabel", bb)
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = "GUN"
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 16
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and not teleportingToGun then
            teleportingToGun = true
            local hrp = lp.Character.HumanoidRootPart
            oldPosition = hrp.CFrame
            
            hrp.CFrame = gunPart.CFrame * CFrame.new(0, 1, 0)
            task.wait(0.25)
            
            if oldPosition then hrp.CFrame = oldPosition oldPosition = nil end
            task.wait(0.5)
            teleportingToGun = false
        end
    end
end

workspace.ChildAdded:Connect(setupDroppedGun)

-- Katil Bulucu
local function findKiller()
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if getPlayerRole(p) == "Katil" then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - cam.CFrame.Position).Magnitude
                if dist < bestDist then bestDist = dist best = p end
            end
        end
    end
    return best
end

-- Ateş Etme Motoru
local function doShoot()
    if shooting then return end
    shooting = true
    local char = lp.Character
    local target = findKiller()
    local gun = char and (char:FindFirstChild("Gun") or lp.Backpack:FindFirstChild("Gun"))
    
    if char and target and gun then
        if gun.Parent == lp.Backpack then
            char:FindFirstChildOfClass("Humanoid"):EquipTool(gun)
            task.wait()
        end
        local shootRemote = gun:FindFirstChild("Shoot")
        local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        
        if shootRemote and tHrp and myHrp then
            local targetPos = tHrp.Position + (tHrp.AssemblyLinearVelocity or Vector3.new()) * CONFIG.predDelay
            myHrp.CFrame = CFrame.new(myHrp.Position, Vector3.new(targetPos.X, myHrp.Position.Y, targetPos.Z))
            pcall(function()
                shootRemote:FireServer(myHrp.CFrame * CFrame.new(0, 0.5, -1.5), CFrame.new(targetPos))
            end)
        end
    end
    task.wait(0.01)
    shooting = false
end

-- Speed Glitch Altyapısı
UIS.JumpRequest:Connect(function() if SPEED_GLITCH_ON then userIsJumping = true end end)
RunService.Heartbeat:Connect(function()
    if not SPEED_GLITCH_ON then return end
    local char = lp.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end

    local state = humanoid:GetState()
    local isFalling = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)

    if userIsJumping and isFalling and humanoid.MoveDirection.Magnitude > 0 then
        local direction = humanoid.MoveDirection
        hrp.AssemblyLinearVelocity = Vector3.new(direction.X * GLITCH_HIZI, hrp.AssemblyLinearVelocity.Y, direction.Z * GLITCH_HIZI)
    else
        if state == Enum.HumanoidStateType.Landed then userIsJumping = false end
    end
end)

