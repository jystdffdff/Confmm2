-- Slider Eleman Oluşturucu
local function addSlider(y, name, min, max, default, cb)
    local row = Instance.new("Frame", main)
    row.Size = UDim2.new(0.92, 0, 0, 36)
    row.Position = UDim2.new(0.04, 0, 0, y)
    row.BackgroundColor3 = Color3.fromRGB(22, 18, 32)
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.4, 0, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(230, 225, 245)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local slideBg = Instance.new("Frame", row)
    slideBg.Size = UDim2.new(0.5, -10, 0, 6)
    slideBg.Position = UDim2.new(0.5, 0, 0.5, -3)
    slideBg.BackgroundColor3 = Color3.fromRGB(45, 38, 62)
    Instance.new("UICorner", slideBg)

    local slideFill = Instance.new("Frame", slideBg)
    slideFill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
    slideFill.BackgroundColor3 = Color3.fromRGB(145, 60, 240)
    Instance.new("UICorner", slideFill)

    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size = UDim2.new(0.1, 0, 1, 0)
    valLbl.Position = UDim2.new(0.4, -5, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(default)
    valLbl.TextColor3 = Color3.fromRGB(150, 130, 190)
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 10

    local sliderBtn = Instance.new("TextButton", slideBg)
    sliderBtn.Size = UDim2.new(1, 0, 1, 0)
    sliderBtn.BackgroundTransparency = 1
    sliderBtn.Text = ""

    local function updateSlider(input)
        local percentage = math.clamp((input.Position.X - slideBg.AbsolutePosition.X) / slideBg.AbsoluteSize.X, 0, 1)
        slideFill.Size = UDim2.new(percentage, 0, 1, 0)
        local value = math.floor(min + (percentage * (max - min)))
        valLbl.Text = tostring(value)
        cb(value)
    end

    local sliding = false
    sliderBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true updateSlider(input) end end)
    UIS.InputChanged:Connect(function(input) if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end end)
end

